# Local-dev reverse proxy / API gateway (issue #60).
#
# Single origin for the whole stack: the browser talks only to http://localhost:9099,
# Caddy routes by path to the right service over the compose network. This
# mirrors the production Kubernetes ingress; here it just runs locally.
#
# All backend services live under /api and know their own full path — no
# prefix stripping needed. /api/auth is handled by Better Auth; every other
# service owns its own /api/<service> subtree.

:80 {
	# Auth service — /api/auth is owned by Better Auth.
	handle /api/auth/* {
		reverse_proxy auth-service:3000
	}

	# Backend services — forwarded as-is (services own their full path).
	handle /api/transactions/* {
		reverse_proxy transaction-service:8080
	}
	handle /api/budgets/* {
		reverse_proxy budget-service:8082
	}
	handle /api/notifications/* {
		reverse_proxy notification-service:8081
	}
	handle /api/genai/* {
		reverse_proxy genai-service:8000
	}

	handle /docs* {
		reverse_proxy swagger-ui:8080
	}

	# Everything else -> the React client (Vite dev server).
	# reverse_proxy upgrades websockets, so Vite HMR works through Caddy.
	handle {
		reverse_proxy client:4200
	}
}
