# Copy to .env and adjust. Compose auto-loads .env from the project root.

# --- Postgres ---
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- pgAdmin (dev only) ---
PGADMIN_DEFAULT_EMAIL=dev@team99.dev
PGADMIN_DEFAULT_PASSWORD=devpass
PGADMIN_PORT=5050

# --- Auth service (Better Auth) ---
# Single source of truth for auth config (both Docker and native Nx runs).
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# From Google Cloud Console (OAuth 2.0 Web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used by native `nx serve auth-service` (Docker compose builds its own values).
DATABASE_URL=postgresql://devuser:devpass@localhost:5432/auth_db
# Browser-facing origin = the Caddy gateway (http://localhost:9099).
BETTER_AUTH_URL=http://localhost:9099

