# Copy to .env and adjust. Compose auto-loads .env from the project root.

# --- Postgres ---
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- pgAdmin (dev only) ---
PGADMIN_DEFAULT_EMAIL=dev@team99.dev
PGADMIN_DEFAULT_PASSWORD=devpass
PGADMIN_PORT=5050

# --- Prod image pulls (compose.prod.yaml) ---
# Set when running the prod stack against pre-built images.
# IMAGE_REGISTRY=ghcr.io/aet-devops26
# IMAGE_TAG=v1.0.0
