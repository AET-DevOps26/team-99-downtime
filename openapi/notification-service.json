{
  "components": {
    "schemas": {
      "NotificationCreateRequest": {
        "properties": {
          "amountLeft": {
            "type": "number"
          },
          "categoryId": {
            "format": "uuid",
            "type": "string"
          },
          "categoryName": {
            "minLength": 1,
            "type": "string"
          },
          "percentUsed": {
            "type": "number"
          },
          "threshold": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "amountLeft",
          "categoryId",
          "categoryName",
          "percentUsed"
        ],
        "type": "object"
      },
      "NotificationResponse": {
        "properties": {
          "amountLeft": {
            "type": "number"
          },
          "categoryId": {
            "format": "uuid",
            "type": "string"
          },
          "categoryName": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "percentUsed": {
            "type": "number"
          },
          "readAt": {
            "format": "date-time",
            "type": "string"
          },
          "threshold": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "SseEmitter": {
        "properties": {
          "timeout": {
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "Better Auth JWT minted by the auth-service.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "notification-service API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/notifications": {
      "get": {
        "operationId": "list",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/NotificationResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "notification-controller"
        ]
      },
      "post": {
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationResponse"
                }
              }
            },
            "description": "Created"
          }
        },
        "tags": [
          "notification-controller"
        ]
      }
    },
    "/api/notifications/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {},
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "who-am-i-controller"
        ]
      }
    },
    "/api/notifications/stream": {
      "get": {
        "operationId": "stream",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SseEmitter"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "notification-controller"
        ]
      }
    },
    "/api/notifications/{id}/read": {
      "patch": {
        "operationId": "markAsRead",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "notification-controller"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
