{
  "openapi": "3.1.0",
  "info": {
    "title": "ExpenseFlow AI Service",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/genai/categorize": {
      "post": {
        "summary": "Categorize Expenses",
        "description": "Extract one or more structured expenses from a free-text sentence.\n\n422 \"TOO_VAGUE\" is the contract for a sentence the model cannot extract from.",
        "operationId": "categorize_expenses_api_genai_categorize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategorizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategorizeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/genai/parse-csv": {
      "post": {
        "summary": "Parse Csv Expenses",
        "description": "Extract one expense per debit row from a raw bank CSV of any format.\n\n422 \"NOT_CSV\" is the contract for content that isn't tabular data at all;\nindividual unusable rows come back under \"skipped\" instead of failing.",
        "operationId": "parse_csv_expenses_api_genai_parse_csv_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseCsvRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseCsvResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/genai/me": {
      "get": {
        "summary": "Me",
        "description": "Probe proving JWT validation works end-to-end.",
        "operationId": "me_api_genai_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CategorizeRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CategorizeRequest"
      },
      "CategorizeResponse": {
        "properties": {
          "expenses": {
            "items": {
              "$ref": "#/components/schemas/ParsedExpense"
            },
            "type": "array",
            "title": "Expenses"
          }
        },
        "type": "object",
        "required": [
          "expenses"
        ],
        "title": "CategorizeResponse"
      },
      "CsvRowExpense": {
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "EUR"
          },
          "merchant": {
            "type": "string",
            "title": "Merchant"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "row": {
            "type": "integer",
            "minimum": 1,
            "title": "Row"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "merchant",
          "category",
          "date",
          "row"
        ],
        "title": "CsvRowExpense",
        "description": "One expense extracted from a CSV data row."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ParseCsvRequest": {
        "properties": {
          "csv": {
            "type": "string",
            "title": "Csv"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "csv"
        ],
        "title": "ParseCsvRequest"
      },
      "ParseCsvResponse": {
        "properties": {
          "expenses": {
            "items": {
              "$ref": "#/components/schemas/CsvRowExpense"
            },
            "type": "array",
            "title": "Expenses"
          },
          "skipped": {
            "items": {
              "$ref": "#/components/schemas/SkippedRow"
            },
            "type": "array",
            "title": "Skipped"
          }
        },
        "type": "object",
        "required": [
          "expenses",
          "skipped"
        ],
        "title": "ParseCsvResponse"
      },
      "ParsedExpense": {
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "EUR"
          },
          "merchant": {
            "type": "string",
            "title": "Merchant"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "merchant",
          "category",
          "date"
        ],
        "title": "ParsedExpense",
        "description": "One expense extracted from the sentence."
      },
      "SkippedRow": {
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 1,
            "title": "Row"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "row",
          "reason"
        ],
        "title": "SkippedRow",
        "description": "A CSV row that could not be imported, with the reason why."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
