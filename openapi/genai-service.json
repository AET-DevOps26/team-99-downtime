{
  "openapi": "3.1.0",
  "info": {
    "title": "ExpenseFlow AI Service",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/genai/categorize": {
      "post": {
        "summary": "Categorize Expenses",
        "description": "Extract one or more structured expenses from a free-text sentence.\n\n422 \"TOO_VAGUE\" is the contract for a sentence the model cannot extract from.",
        "operationId": "categorize_expenses_api_genai_categorize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategorizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategorizeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/genai/parse-file": {
      "post": {
        "summary": "Parse File Expenses",
        "description": "Extract one expense per row/line from a bank CSV or free-text notes file.\n\n422 \"UNREADABLE_FILE\" is the contract for content with no expense data at\nall; individually unusable rows come back under \"skipped\" instead.",
        "operationId": "parse_file_expenses_api_genai_parse_file_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseFileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseFileResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/genai/me": {
      "get": {
        "summary": "Me",
        "description": "Probe proving JWT validation works end-to-end.",
        "operationId": "me_api_genai_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CategorizeRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CategorizeRequest"
      },
      "CategorizeResponse": {
        "properties": {
          "expenses": {
            "items": {
              "$ref": "#/components/schemas/ParsedExpense"
            },
            "type": "array",
            "title": "Expenses"
          }
        },
        "type": "object",
        "required": [
          "expenses"
        ],
        "title": "CategorizeResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ParseFileRequest": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "ParseFileRequest"
      },
      "ParseFileResponse": {
        "properties": {
          "expenses": {
            "items": {
              "$ref": "#/components/schemas/RowExpense"
            },
            "type": "array",
            "title": "Expenses"
          },
          "skipped": {
            "items": {
              "$ref": "#/components/schemas/SkippedRow"
            },
            "type": "array",
            "title": "Skipped"
          }
        },
        "type": "object",
        "required": [
          "expenses",
          "skipped"
        ],
        "title": "ParseFileResponse"
      },
      "ParsedExpense": {
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "EUR"
          },
          "merchant": {
            "type": "string",
            "title": "Merchant"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "merchant",
          "category",
          "date"
        ],
        "title": "ParsedExpense",
        "description": "One expense extracted from the sentence."
      },
      "RowExpense": {
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "EUR"
          },
          "merchant": {
            "type": "string",
            "title": "Merchant"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "row": {
            "type": "integer",
            "minimum": 1,
            "title": "Row"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "merchant",
          "category",
          "date",
          "row"
        ],
        "title": "RowExpense",
        "description": "One expense extracted from a row/line of an uploaded file."
      },
      "SkippedRow": {
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 1,
            "title": "Row"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "row",
          "reason"
        ],
        "title": "SkippedRow",
        "description": "A row/line that could not be imported, with the reason why."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
