{
  "components": {
    "schemas": {
      "CategorizeRequest": {
        "properties": {
          "categories": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Categories",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "CategorizeRequest",
        "type": "object"
      },
      "CategorizeResponse": {
        "properties": {
          "expenses": {
            "items": {
              "$ref": "#/components/schemas/ParsedExpense"
            },
            "title": "Expenses",
            "type": "array"
          }
        },
        "required": [
          "expenses"
        ],
        "title": "CategorizeResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LastWeekTotals": {
        "description": "Aggregate of the previous week, for the week-over-week comparison.",
        "properties": {
          "count": {
            "minimum": 0,
            "title": "Count",
            "type": "integer"
          },
          "total": {
            "minimum": 0,
            "title": "Total",
            "type": "number"
          }
        },
        "required": [
          "total",
          "count"
        ],
        "title": "LastWeekTotals",
        "type": "object"
      },
      "ParseFileRequest": {
        "properties": {
          "categories": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Categories",
            "type": "array"
          },
          "content": {
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "ParseFileRequest",
        "type": "object"
      },
      "ParseFileResponse": {
        "properties": {
          "expenses": {
            "items": {
              "$ref": "#/components/schemas/RowExpense"
            },
            "title": "Expenses",
            "type": "array"
          },
          "skipped": {
            "items": {
              "$ref": "#/components/schemas/SkippedRow"
            },
            "title": "Skipped",
            "type": "array"
          }
        },
        "required": [
          "expenses",
          "skipped"
        ],
        "title": "ParseFileResponse",
        "type": "object"
      },
      "ParsedExpense": {
        "description": "One expense extracted from the sentence.",
        "properties": {
          "amount": {
            "exclusiveMinimum": 0,
            "title": "Amount",
            "type": "number"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "currency": {
            "default": "EUR",
            "title": "Currency",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "merchant": {
            "title": "Merchant",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "merchant",
          "category",
          "date"
        ],
        "title": "ParsedExpense",
        "type": "object"
      },
      "RowExpense": {
        "description": "One expense extracted from a row/line of an uploaded file.",
        "properties": {
          "amount": {
            "exclusiveMinimum": 0,
            "title": "Amount",
            "type": "number"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "currency": {
            "default": "EUR",
            "title": "Currency",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "merchant": {
            "title": "Merchant",
            "type": "string"
          },
          "row": {
            "minimum": 1,
            "title": "Row",
            "type": "integer"
          }
        },
        "required": [
          "amount",
          "merchant",
          "category",
          "date",
          "row"
        ],
        "title": "RowExpense",
        "type": "object"
      },
      "SkippedRow": {
        "description": "A row/line that could not be imported, with the reason why.",
        "properties": {
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "row": {
            "minimum": 1,
            "title": "Row",
            "type": "integer"
          }
        },
        "required": [
          "row",
          "reason"
        ],
        "title": "SkippedRow",
        "type": "object"
      },
      "SummaryResponse": {
        "properties": {
          "generatedAt": {
            "format": "date-time",
            "title": "Generatedat",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "weekStart": {
            "format": "date",
            "title": "Weekstart",
            "type": "string"
          }
        },
        "required": [
          "summary",
          "weekStart",
          "generatedAt"
        ],
        "title": "SummaryResponse",
        "type": "object"
      },
      "SummaryTransaction": {
        "description": "One expense of the week being summarized, as sent by the caller.",
        "properties": {
          "amount": {
            "exclusiveMinimum": 0,
            "title": "Amount",
            "type": "number"
          },
          "currency": {
            "default": "EUR",
            "title": "Currency",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "date",
          "amount",
          "description"
        ],
        "title": "SummaryTransaction",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WeeklyData": {
        "description": "The summarize request payload: one week of expenses plus context.",
        "properties": {
          "lastWeek": {
            "$ref": "#/components/schemas/LastWeekTotals"
          },
          "thisWeek": {
            "items": {
              "$ref": "#/components/schemas/SummaryTransaction"
            },
            "title": "Thisweek",
            "type": "array"
          },
          "weekStart": {
            "format": "date",
            "title": "Weekstart",
            "type": "string"
          }
        },
        "required": [
          "weekStart",
          "thisWeek",
          "lastWeek"
        ],
        "title": "WeeklyData",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "ExpenseFlow AI Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/genai/categorize": {
      "post": {
        "description": "Extract one or more structured expenses from a free-text sentence.\n\n422 \"TOO_VAGUE\" is the contract for a sentence the model cannot extract from.",
        "operationId": "categorize_expenses_api_genai_categorize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategorizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategorizeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Categorize Expenses"
      }
    },
    "/api/genai/me": {
      "get": {
        "description": "Probe proving JWT validation works end-to-end.",
        "operationId": "me_api_genai_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me"
      }
    },
    "/api/genai/parse-file": {
      "post": {
        "description": "Extract one expense per row/line from a bank CSV or free-text notes file.\n\n422 \"UNREADABLE_FILE\" is the contract for content with no expense data at\nall; individually unusable rows come back under \"skipped\" instead.",
        "operationId": "parse_file_expenses_api_genai_parse_file_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseFileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseFileResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Parse File Expenses"
      }
    },
    "/api/genai/summarize": {
      "post": {
        "description": "Generate and persist the calling user's summary for the given week.\n\nThe caller supplies the week's numbers (the dashboard forwards them from\ntransaction-service's GET /api/transactions/weekly-report). 422\n\"NOT_ENOUGH_DATA\" is the contract for a week too sparse to summarize —\nnothing is stored then.",
        "operationId": "summarize_week_api_genai_summarize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WeeklyData"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Summarize Week"
      }
    },
    "/api/genai/summarize/latest": {
      "get": {
        "description": "The most recent stored summary; 404 \"NO_SUMMARY\" before the first one.",
        "operationId": "latest_summary_api_genai_summarize_latest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Latest Summary"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    }
  }
}
