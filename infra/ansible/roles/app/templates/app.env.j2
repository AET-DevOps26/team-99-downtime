# Rendered by Ansible — do not edit on the host. docker compose auto-loads this.
REGISTRY={{ registry }}
APP_IMAGE_TAG={{ app_image_tag }}

POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}

# Browser-facing origin (OAuth redirects, cookies, token issuer).
# The scheme is stripped from `domain` first so a full-URL APP_DOMAIN value
# can't render a broken https://https://… origin (which 404s all auth routes).
PUBLIC_ORIGIN={{ ('https://' + (domain | regex_replace('^https?://', ''))) if domain else ('http://' + inventory_hostname) }}

BETTER_AUTH_SECRET={{ better_auth_secret }}
GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}

# Logos LLM gateway (genai-service expense extraction).
LLM_API_KEY={{ llm_api_key }}
