{
  "name": "transaction-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/transaction-service/src",
  "targets": {
    "serve": {
      "metadata": {
        "description": "Run the application"
      },
      "executor": "@nx/gradle:gradle",
      "continuous": true,
      "options": {
        "taskName": "bootRun"
      }
    },
    "dev": {
      "metadata": {
        "description": "Run the application in development mode with continuous build"
      },
      "executor": "@nx/gradle:gradle",
      "continuous": true,
      "options": {
        "taskName": "bootRun",
        "args": ["--continuous"]
      }
    }
  },
  "tags": []
}
