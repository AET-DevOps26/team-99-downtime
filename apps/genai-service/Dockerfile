
FROM python:3.13-slim

# Python environment optimizations
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Install 'uv' by copying the binary from the official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy the artifacts generated by Nx
COPY dist/apps/genai-service /app/artifacts

# Install the package using 'uv'
# This installs the .whl file and all its dependencies (FastAPI, Uvicorn, etc.)
RUN uv pip install --system /app/artifacts/*.whl

# Cleanup to keep the image small
RUN rm -rf /app/artifacts

# Set the default port (FastAPI/Uvicorn default is 8000)
EXPOSE 8000

# Start the service
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
