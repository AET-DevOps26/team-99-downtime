{
  "name": "notification-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/notification-service/src",
  "targets": {
    "serve": {
      "metadata": {
        "description": "Run the application"
      },
      "executor": "@nx/gradle:gradle",
      "continuous": true,
      "options": {
        "taskName": "bootRun"
      }
    },
    "dev": {
      "metadata": {
        "description": "Run the application in development mode with continuous build"
      },
      "executor": "@nx/gradle:gradle",
      "continuous": true,
      "options": {
        "taskName": "bootRun",
        "args": ["--continuous"]
      }
    },
    "build": {
      "options": {
        "//": "bootJar lazily resolves commons-jvm's artifact; Nx must not pass --exclude-task for it or bootJar fails evaluating resolvedDependencies. See https://github.com/nrwl/nx docs on includeDependsOnTasks.",
        "includeDependsOnTasks": [":commons-jvm:jar"]
      }
    }
  },
  "tags": [],
  "release": {
    "docker": {
      "repositoryName": "aet-devops26/team-99-downtime/t99-notification-service"
    }
  }
}
